# Python
__pycache__/
*.pyc
*.py[cod]
*.pyo

# Virtual environment
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
!.env.example

# Editors
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local outputs
# downloads/ 는 통째로 무시하되 수체탐지 로그 CSV(수 KB)만 예외로 추적한다.
# 래스터는 재처리로 복구 가능하지만 임계값·면적 이력을 잃으면 재현 근거가
# 사라진다. git은 부모 디렉터리가 제외되면 하위 파일을 되살릴 수 없어,
# "downloads/*" -> water_otsu 디렉터리만 되살림 -> 그 안도 파일 2개만 되살림
# 순서로 단계적으로 적는다.
downloads/*
!downloads/water_otsu/
downloads/water_otsu/*
!downloads/water_otsu/otsu_thresholds.csv
!downloads/water_otsu/water_area_perrow.csv
outputs/
tmp/
temp/

# Data / satellite products
*.SAFE
*.SAFE/
*.zip
*.tar
*.tif
*.tiff
*.nc

# SQLite / catalog
*.db
*.sqlite
*.sqlite3
*.db-journal

# MinIO / cache / misc
.cache/

# third-party sources obtained externally (installed via pip; not versioned here)
sarsen-main/
sarsen-0.9.6/
sarsen-0.9.6.tar.gz
xarray-sentinel-main/
sardem-sarsen-main/

# raw support emails (personal info: address, Dell case)
*.eml

# RTC/footprint 감사 산출물(스크립트로 재생성 가능)
s1/footprint/*.csv

# 벡터 데이터 스냅샷(재생성 가능한 산출물)
*.gpkg

# 배치 실행 로그·임시 체이닝 스크립트 — 재실행하면 다시 생긴다.
# 로그는 temp/logs/ 에 쓴다(temp/ 는 위에서 통째로 무시). 루트에 쌓지 말 것 —
# 주요 내용은 docs/worklog/ISSUES_KR.md 에 옮겨 적는다.
*.err
_chain*.ps1

# 별도 분석 작업공간(3.9GB: QGIS 프로젝트·보고서·NAS 사본 등). 코드가 아니라
# 데이터·문서 더미라 저장소에 넣지 않는다.
20260709_flood/

# 실험·벤치마크 산출물(래스터). README 만 추적한다 — experiments/README_KR.md
experiments/*
!experiments/README_KR.md

# PyInstaller 배포본(SentinelObservationPlan.exe 262 MB). *.zip 은 위에서 이미
# 무시되지만 exe 는 걸리지 않아, `git add -A` 한 번이면 262 MB 바이너리가
# 커밋된다(GitHub 파일당 100 MB 한도에 걸려 push 도 막힌다). 소스가 저장소에
# 없으므로 산출물만 두는 폴더다 — CSV 3개는 입력 자료라 추적한다.
SentinelObservationPlan/*.exe
